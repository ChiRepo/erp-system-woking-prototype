# =============================================================================
# KRC Institute of Technology - ERP Environment Configuration TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Application Settings
VITE_APP_NAME="KRC Institute of Technology"
VITE_APP_ENV="production"

# Optional override of the deployed authenticated media service.
# Empty uses the ERP Workers endpoint; browser signing is unavailable.
# Include the API path, e.g. https://media.your-domain.example/api/media.
# This is a public address, never a place for storage keys or other secrets.
VITE_MEDIA_API_URL=

# Firebase Public Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
